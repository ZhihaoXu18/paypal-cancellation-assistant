# Local configuration template only. Do not overwrite an existing .env.
# Add these names to your .env yourself. Never commit real credentials.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Server-side OpenAI credential. Leave blank to display AI not configured.
OPENAI_API_KEY=
# Supported Responses API model with Structured Outputs:
OPENAI_MODEL=gpt-4.1-mini
